// ===========================
// Movement Functions
// Functions that handle player movement
// ===========================

/**
 * Handles movement between locations
 * @param {number} choiceNum The chosen option number
 * @returns {boolean} True if movement was successful
 */
function move(choiceNum) {
    let validMove = false;
    
    if (currentLocation === "village") {
        if (choice === 1) currentLocation = "blacksmith";
        else if (choice === 2) currentLocation = "market";
        else if (choice === 3) {
            if (inventory.filter(item => item.type === "weapon").length === 0) {
                console.log("It's too dangerous to enter the forest without a weapon! Visit the Blacksmith first.");
                return false; 
            }
            currentLocation = "forest";
        }
        else if (choice === 4) showStatus();
        else if (choice === 5) usePotion();
        else if (choice === 6) showHelp();
        else if (choice === 7) gameRunning = false;
    }

    else if (currentLocation === "blacksmith") {
        if (choice >= 1 && choice <= 4) buyFromBlacksmith(choice);
        else if (choice === 5) currentLocation = "village";
        else if (choice === 6) showStatus();
        else if (choice === 7) usePotion();
        else if (choice === 8) gameRunning = false;
    }
    else if (currentLocation === "market") {
        if (choice === 1) buyFromMarket(choice);
        else if (choice === 2) currentLocation = "village";
        else if (choice === 3) showStatus();
        else if (choice === 4) usePotion();
        else if (choice === 5) showHelp();
        else if (choice === 6) gameRunning = false;
        }
    
    else if (currentLocation === "forest") {
        if (choice === 1) handleCombat(false); 
        else if(choice === 2){
            if (!hasGoodEquipment()) {
                console.log("You do not have good enough equipment to face the Dragon!");
                console.log("You must have a Steel Sword and at least one type of shield (Armor).");
                    return false;
                }
                    handleCombat(true);}
         else if (choice === 3) 
            currentLocation = "village";
        else if (choice === 4) 
                showStatus();
        else if (choice === 5) 
                usePotion();
        else if (choice === 6) 
            gameRunning = false;
        }
    return true;}

// ===========================
// Input Validation
// Functions that validate player input
// ===========================

/**
 * Validates if a choice number is within valid range
 * @param {string} input The user input to validate
 * @param {number} max The maximum valid choice number
 * @returns {boolean} True if choice is valid
 */
function isValidChoice(maxChoice) {
    while (true) {
        try {
            // 1. Get the player's input from the terminal
            let input = readline.question("\nEnter your choice number: ");
            let num = parseInt(input);

            // 2. Validate the input against the maximum allowed choices
            if (isNaN(num) || num < 1 || num > maxChoice) {
                // Trigger the catch block by throwing a custom error message
                throw new Error("Invalid option selection! Please try again.");
            }
            // 3. If valid, return the number to break the loop and continue the game
            return num;

        } catch (error) {
            // 4. Catch block handles the error and prints your helpful message
            console.log("Some error appeared during the Games play" + error.message);
            // The loop naturally continues, allowing the user to retry safely
        }
    }
}

// ===========================
// Main Game Loop
// Controls the flow of the game
// ===========================

console.log("=================================");
console.log("       The Dragon's Quest        ");
console.log("=================================");
console.log("\nYour quest: Defeat the dragon in the mountains!");

// Get player's name
playerName = readline.question("\nWhat is your name, brave adventurer? ");
console.log("\nWelcome, " + playerName + "!");
console.log("You start with " + playerGold + " gold.");

while (gameRunning) {
    // Show current location and choices
    showLocation();
    
    // Get and validate player choice
    let validChoice = false;
    while (!validChoice) {
        try {
            let choice = readline.question("\nEnter choice (number): ");
            
            // Check for empty input
            if (choice.trim() === "") {
                throw "Please enter a number!";
            }
            
            // Convert to number and check if it's a valid number
            let choiceNum = parseInt(choice);
            if (isNaN(choiceNum)) {
                throw "That's not a number! Please enter a number.";
            }
            
            // Handle choices based on location
            if (currentLocation === "village") {
                if (choiceNum < 1 || choiceNum > 7) {
                    throw "Please enter a number between 1 and 7.";
                }
                
                validChoice = true;
                
                if (choiceNum <= 3) {
                    move(choiceNum);
                }
                else if (choiceNum === 4) {
                    showStatus();
                }
                else if (choiceNum === 5) {
                    useItem();
                }
                else if (choiceNum === 6) {
                    showHelp();
                }
                else if (choiceNum === 7) {
                    gameRunning = false;
                    console.log("\nThanks for playing!");
                }
            }
            else if (currentLocation === "blacksmith") {
                if (choiceNum < 1 || choiceNum > 6) {
                    throw "Please enter a number between 1 and 6.";
                }
                
                validChoice = true;
                
                if (choiceNum === 1) {
                    buyFromBlacksmith();
                }
                else if (choiceNum === 2) {
                    move(choiceNum);
                }
                else if (choiceNum === 3) {
                    showStatus();
                }
                else if (choiceNum === 4) {
                    useItem();
                }
                else if (choiceNum === 5) {
                    showHelp();
                }
                else if (choiceNum === 6) {
                    gameRunning = false;
                    console.log("\nThanks for playing!");
                }
            }
            else if (currentLocation === "market") {
                if (choiceNum < 1 || choiceNum > 6) {
                    throw "Please enter a number between 1 and 6.";
                }
                
                validChoice = true;
                
                if (choiceNum === 1) {
                    buyFromMarket();
                }
                else if (choiceNum === 2) {
                    move(choiceNum);
                }
                else if (choiceNum === 3) {
                    showStatus();
                }
                else if (choiceNum === 4) {
                    useItem();
                }
                else if (choiceNum === 5) {
                    showHelp();
                }
                else if (choiceNum === 6) {
                    gameRunning = false;
                    console.log("\nThanks for playing!");
                }
            }
            else if (currentLocation === "forest") {
                if (choiceNum < 1 || choiceNum > 5) {
                    throw "Please enter a number between 1 and 5.";
                }
                
                validChoice = true;
                
                if (choiceNum === 1) {
                    move(choiceNum);
                }
                else if (choiceNum === 2) {
                    showStatus();
                }
                else if (choiceNum === 3) {
                    useItem();
                }
                else if (choiceNum === 4) {
                    showHelp();
                }
                else if (choiceNum === 5) {
                    gameRunning = false;
                    console.log("Thanks for playing!");
                }
            }
            
        } catch (error) {
            console.log("\nError: " + error);
            console.log("Please try again!");
        }
    }

    // Check if player died
    if (playerHealth <= 0) {
        console.log("\nGame Over! Your health reached 0!");
        gameRunning = false;
    }
}

