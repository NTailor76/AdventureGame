// ===========================
// Combat Functions
// Functions that handle battles and health
// ===========================

/**
 * Checks if player has an item of specified type 
 * @param {string} type The type of item to check for
 * @returns {boolean} True if player has the item type
 */
function hasItemType(type) {
    return inventory.some(item => item.type === type);
}
//=== Equipment checking=====================
function hasGoodequipment(){

    let hasSteelSword = inventory.some(item => item.name ==="Steel Sword"); //// check for advance sword.
    let hasAnyArmor = inventory.some(item => item.type ==="armor"); //check for armor in position
    return hasSteelSword && hasAnyArmor;
}
/**
 * Handles monster battles
 * Checks if player has weapon and manages combat results
 * @returns {boolean} true if player wins, false if they retreat
 */
function handleCombat(isDragon = false) {
    let enemyName = isDragon ? "The Dragon" : "a Forest Monster";
    let enemyDamage = isDragon ? 20 : 10;
    let enemyHealth = isDragon ? 50 : 20;
    console.log("Battle Started: " + enemyName + "!. ");
let bestArmor = null;
    for (let item of inventory) {
        if (item.type === "armor") {
            if (bestArmor === null || item.effect > bestArmor.effect) {
                bestArmor = item;
            }
        }
    }

    if (bestWeapon) {
        console.log("[EQUIPPED] " + bestWeapon.name + " (+" + bestWeapon.effect + " Damage)");
    } else {
        console.log("[EQUIPPED] Bare Fists (0 Damage) - Safe retreat necessary!");
        updateHealth(-20);
        return false;
    }

    if (bestArmor) {
        console.log("[EQUIPPED] " + bestArmor.name + " (Blocks " + bestArmor.effect + " damage)");
    }

    // Turn loop calculations
    while (enemyHealth > 0 && playerHealth > 0) {
        console.log("You strike " + enemyName + "!");
        enemyHealth -= bestWeapon.effect;
        console.log("Dealt " + bestWeapon.effect + " damage. (" + enemyName + " HP: " + Math.max(0, enemyHealth) + ")");

        if (enemyHealth <= 0) break;

        console.log(" " + enemyName + " counter-attacks!");
        let armorProtection = bestArmor ? bestArmor.effect : 0;
        let finalIncomingDamage = enemyDamage - armorProtection;
        
        // Dynamic minimum damage floor check enforcement
        if (finalIncomingDamage < 1) finalIncomingDamage = 1;

        console.log("You sustained " + finalIncomingDamage + " damage.");
        updateHealth(-finalIncomingDamage);

        if (playerHealth <= 0) return false; 
    }

    if (playerHealth > 0) {
        if (isDragon) {
            console.log("CONGRATULATIONS! You have slain the Dragon and saved the kingdom! 🎉");
            gameRunning = false;
        } else {
            console.log("\nVictory! You found 15 gold!");
            playerGold += 15;
        }
        return true;
    }
    return false;
}

/**
 * Updates player health, keeping it between 0 and 100
 * @param {number} amount Amount to change health by (positive for healing, negative for damage)
 * @returns {number} The new health value
 */
function updateHealth(amount) {
    playerHealth += amount;
    
    if (playerHealth > 100) {
        playerHealth = 100;
        console.log("You're at full health!");
    }
    if (playerHealth < 0) {
        playerHealth = 0;
        console.log("You're gravely wounded!");
    }
    
    console.log("Health is now: " + playerHealth);
    return playerHealth;
}

// ===========================
// Item Functions
// Functions that handle item usage and inventory
// ===========================

/**
 * Handles using items like potions
 * @returns {boolean} true if item was used successfully, false if not
 */
function useItem() {
    if (inventory.length === 0) {
        console.log("\nYou have no items!");
        return false;
    }

    console.log("\n=== Inventory ===");
    inventory.forEach((item, index) => {
        console.log((index + 1) + ". " + item.name);
    });
    
    let choice = readline.question("Use which item? (number or 'cancel'): ");
    if (choice === 'cancel') return false;
    
    let index = parseInt(choice) - 1;
    if (index >= 0 && index < inventory.length) {
        let item = inventory[index];
        
        if (item.type === "potion") {
            console.log("\nYou drink the " + item.name + ".");
            updateHealth(item.effect);
            inventory.splice(index, 1);
            console.log("Health restored to: " + playerHealth);
            return true;
        } else if (item.type === "weapon") {
            console.log("\nYou ready your " + item.name + " for battle.");
            return true;
        }
    } else {
        console.log("\nInvalid item number!");
    }
    return false;
}

/**
 * Displays the player's inventory
 */
function checkInventory() {
    console.log("\n=== INVENTORY ===");
    if (inventory.length === 0) {
        console.log("Your inventory is empty!");
        return;
    }
    
    // Display all inventory items with numbers and descriptions
    inventory.forEach((item, index) => {
        console.log((index + 1) + ". " + item.name + " - " + item.description);
    });
}

// ===========================
// Shopping Functions
// Functions that handle buying items
// ===========================

/**
 * Handles purchasing items at the blacksmith
 */
function buyFromBlacksmith() {
let choice = readline.question("Select a number to purchase: ");
switch(choice) {
    case "1": processPurchase(sword); 
        break;
    case "2": processPurchase(steelSword); 
        break;
    case "3": processPurchase(woodenShield); 
        break;
    case "4": processPurchase(ironShield); 
        break;
    case "5": currentLocation = "village"; 
        break;
    case "6": showStatus(); 
        break;
    case "7": useItem(); 
        break;
    case "8": gameRunning = false; 
        break;
    default: console.log("Invalid option!");}
}

// Need to handle purchase and Inventory Storage Pushe function--
function processPurchase(item) {
    let alreadyOwned = inventory.some(i => i.name === item.name);
        if (alreadyOwned) {
            console.log("You already own a " + item.name + "!");
            return;
        }
        if (playerGold >= item.value) {
            playerGold -= item.value;inventory.push({...item});
                console.log("Purchased: " + item.name + "!");} 
            else {
                console.log("Not enough gold! Costs " + item.value + " gold.");
            }
}


/**
 * Handles purchasing items at the market
 */
function buyFromMarket() {
let choice = readline.question("Select an option: ");
    if (choice === "1") {
        if (playerGold >= healthPotion.value) {
            playerGold -= healthPotion.value;
            inventory.push({...healthPotion});
                console.log("\nYou bought a Health Potion!");
            } else 
                {
                console.log("Not enough gold!");
            }
        } else if 
        (choice === "2") {
            currentLocation = "village";
        } else if 
        (choice === "3") 
            {showStatus();
        } else if 
        (choice === "4") 
            {useItem();

        } else if 
        (choice === "6") 
            {gameRunning = false;}}

