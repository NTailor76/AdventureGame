// Get the best item - with a function call.
function getBestItem(type){
    let matchingItems = getItemsByType(type);
        if(matchingItems.length ===  0) return null;
        // Lets take the first index as the best at the start and then check which effects is higher for damanage  
        let bestItem = matchingItems[0];
       
        matchingItems.forEach(item => { if (item.effect > bestItem.effect)
            {bestItem =true;}
        });//
    
        return bestItem;
    }

